# ============================================================
# POLAR NAVIGATOR AI — Environment Variables Template
# Ministry of Earth Sciences (MoES) / NCPOR
# ============================================================

# Application & Data Mode: "demo", "live", or "cached"
DATA_MODE=demo
APP_MODE=DEMO
DEBUG=True

# Optional External Scientific Data Providers
# (If omitted, system automatically operates 100% in DEMO DATA ACTIVE mode)
CDS_API_KEY=
CDS_URL=https://cds.climate.copernicus.eu/api/v2
COPERNICUS_MARINE_USERNAME=
COPERNICUS_MARINE_PASSWORD=
NASA_EARTHDATA_TOKEN=
OPENWEATHER_API_KEY=
AI_API_KEY=

# Optional Managed Database (PostgreSQL / PostGIS)
# Leave empty on Vercel to use fail-safe in-memory / temporary SQLite
DATABASE_URL=

# Optional Redis Cache
REDIS_URL=

# Host & Ports (Local development)
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501

# Security & CORS
CORS_ORIGINS=*
SECRET_KEY=polar-navigator-secure-secret-key-moes-ncpor-2025

# POLAR NAVIGATOR AI - Environment Configuration
# Ministry of Earth Sciences (MoES) / NCPOR

# Application Mode: DEMO or LIVE
APP_MODE=DEMO
DEBUG=True

# Server settings
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501

# Database Configuration (Defaults to SQLite for portable demo, switch to PostgreSQL for production)
DATABASE_URL=sqlite:///./polar_navigator.db
# DATABASE_URL=postgresql://polar_user:polar_pass@localhost:5432/polar_navigator_db

# External API Keys (Optional - Automatic DEMO fallback if missing)
COPERNICUS_API_KEY=
NASA_EARTHDATA_TOKEN=
NOAA_API_KEY=
EUMETSAT_API_KEY=
OPENWEATHER_API_KEY=
OCEAN_DATA_API_KEY=

# Security & CORS
CORS_ORIGINS=*
SECRET_KEY=polar-navigator-secure-secret-key-moes-ncpor-2025
